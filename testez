
%% LABORATOR CONTROL OPTIMAL
% Tema A - Metoda gradientului conjugat
% J(u,v) = 5*u^2 + 4*u*v + 6*v^2 - 16*u - 18*v

clear; clc; close all;
format long g;

%% 1. Definirea problemei

H = [10 4;
      4 12];

b = [16; 18];
c = 0;

% Functia obiectiv
J = @(z) 5*z(1)^2 + 4*z(1)*z(2) ...
       + 6*z(2)^2 - 16*z(1) - 18*z(2);

% Gradientul
gradJ = @(z) H*z - b;

% Punct initial si toleranta
z0 = [-1.5; -1.0];
epsCG = 1e-8;
maxIter = 100;

fprintf('TEMA A - DIRECTII CONJUGATE\n');
fprintf('===========================\n');

%% 2. Verificarea Hessienei

Delta1 = H(1,1);
Delta2 = det(H);
valoriProprii = eig(H);

fprintf('\nMatricea Hessian H:\n');
disp(H);

fprintf('Primul minor principal = %.6f\n', Delta1);
fprintf('Determinantul H = %.6f\n', Delta2);
fprintf('Valorile proprii ale H:\n');
disp(valoriProprii);

if Delta1 > 0 && Delta2 > 0
    fprintf('H este pozitiv definita.\n');
else
    error('H nu este pozitiv definita.');
end

%% 3. Solutia analitica: H*z = b

zExact = H\b;
JExact = J(zExact);

fprintf('\nSOLUTIA ANALITICA\n');
fprintf('u* = %.10f\n', zExact(1));
fprintf('v* = %.10f\n', zExact(2));
fprintf('J(z*) = %.10f\n', JExact);
fprintf('Norma gradientului = %.3e\n', ...
    norm(gradJ(zExact), 2));

%% 4. Metoda gradientului conjugat

z = z0;
g = gradJ(z);
d = -g;

% Datele care vor forma tabelul
kList = [];
uList = [];
vList = [];
d1List = [];
d2List = [];
alphaList = [];
JList = [];
normGList = [];

% Traiectoria: fiecare coloana este un punct
Z = z0;

for k = 0:maxIter-1

    % Criteriul de oprire
    if norm(g, 2) < epsCG
        break;
    end

    % Pasul optim exact
    alpha = -(g' * d) / (d' * H * d);

    % Salvam datele iteratiei k
    kList(end+1,1) = k;
    uList(end+1,1) = z(1);
    vList(end+1,1) = z(2);
    d1List(end+1,1) = d(1);
    d2List(end+1,1) = d(2);
    alphaList(end+1,1) = alpha;
    JList(end+1,1) = J(z);
    normGList(end+1,1) = norm(g, 2);

    % Actualizarea punctului
    zNou = z + alpha*d;
    gNou = gradJ(zNou);

    Z(:,end+1) = zNou;

    % Oprire daca s-a atins toleranta
    if norm(gNou, 2) < epsCG
        z = zNou;
        g = gNou;
        break;
    end

    % Coeficientul Fletcher-Reeves
    beta = (gNou' * gNou) / (g' * g);

    % Noua directie conjugata
    dNou = -gNou + beta*d;

    % Pregatirea iteratiei urmatoare
    z = zNou;
    g = gNou;
    d = dNou;
end

%% 5. Tabelul iteratiilor

T = table(kList, uList, vList, d1List, d2List, ...
    alphaList, JList, normGList, ...
    'VariableNames', {'k','u_k','v_k','d1_k','d2_k', ...
    'alpha_k','J_z_k','NormaGradientului'});

fprintf('\nTABELUL ITERATIILOR\n');
disp(T);

fprintf('Numar de pasi executati: %d\n', length(alphaList));
fprintf('Solutia obtinuta prin directii conjugate:\n');
disp(z);
fprintf('Valoarea functiei: %.12f\n', J(z));
fprintf('Norma gradientului final: %.3e\n', norm(gradJ(z),2));

%% 6. Comparatie cu solutia analitica

fprintf('\nCOMPARATIE CU H\\b\n');
fprintf('Eroare ||zCG - zExact||2 = %.3e\n', ...
    norm(z-zExact,2));
fprintf('Eroare functionala = %.3e\n', abs(J(z)-JExact));

%% 7. Grafic Surface cu traiectoria

u = linspace(min(Z(1,:))-0.8, max(Z(1,:))+0.8, 120);
v = linspace(min(Z(2,:))-0.8, max(Z(2,:))+0.8, 120);
[U,V] = meshgrid(u,v);

F = 5*U.^2 + 4*U.*V + 6*V.^2 - 16*U - 18*V;

figure('Name','Surface - Tema A');
surf(U,V,F);
shading interp;
hold on;

plot3(Z(1,:), Z(2,:), arrayfun(@(i) J(Z(:,i)), ...
    1:size(Z,2)), 'r-o', 'LineWidth', 2, ...
    'MarkerFaceColor','r','MarkerSize',6);

plot3(zExact(1), zExact(2), JExact, ...
    'kp','MarkerFaceColor','y','MarkerSize',12);

xlabel('u');
ylabel('v');
zlabel('J(u,v)');
title('Suprafata functiei si traiectoria gradientului conjugat');
legend('J(u,v)','Traiectoria','Minim analitic', ...
    'Location','best');
grid on;
view(45,30);
hold off;

%% 8. Grafic contour cu traiectoria

figure('Name','Contour - Tema A');

contour(U,V,F,25,'ShowText','on');
hold on;

plot(Z(1,:), Z(2,:), 'r-o', ...
    'LineWidth', 2, 'MarkerFaceColor','r','MarkerSize',6);

plot(zExact(1), zExact(2), 'kp', ...
    'MarkerFaceColor','y','MarkerSize',12);

xlabel('u');
ylabel('v');
title('Curbe de nivel si traiectoria iteratiilor');
legend('Curbe de nivel','Traiectoria','Minim analitic', ...
    'Location','best');
grid on;
axis equal;
hold off;

%% 9. Comparatie optionala cu fminunc

fprintf('\nCOMPARATIE CU fminunc\n');

if exist('fminunc','file') == 2

    options = optimoptions('fminunc', ...
        'Algorithm','quasi-newton', ...
        'Display','off', ...
        'OptimalityTolerance',1e-8, ...
        'StepTolerance',1e-12);

    [zFmin, JFmin, exitflag] = fminunc(J, z0, options);

    fprintf('u_fminunc = %.10f\n', zFmin(1));
    fprintf('v_fminunc = %.10f\n', zFmin(2));
    fprintf('J_fminunc = %.10f\n', JFmin);
    fprintf('Norma gradientului = %.3e\n', ...
        norm(gradJ(zFmin),2));
    fprintf('Eroare fata de H\\b = %.3e\n', ...
        norm(zFmin-zExact,2));
    fprintf('Exitflag = %d\n', exitflag);

else
    fprintf(['fminunc nu este disponibil. ', ...
        'Este necesar Optimization Toolbox.\n']);
end

%% 10. Influenta punctului initial si a tolerantei

fprintf('\nTEST: PUNCT INITIAL SI TOLERANTA\n');

puncteInitiale = {[-1.5;-1.0], [0;0], [5;-3]};
tolerante = [1e-4, 1e-8, 1e-12];

for ip = 1:length(puncteInitiale)
    for it = 1:length(tolerante)

        [zTest, nPasi, normaFinala] = ...
            rezolvaCG(H,b,puncteInitiale{ip}, ...
            tolerante(it),maxIter);

        fprintf(['z0=(%.2f, %.2f), eps=%.0e, ', ...
            'pasi=%d, eroare=%.3e, ||g||=%.3e\n'], ...
            puncteInitiale{ip}(1), ...
            puncteInitiale{ip}(2), tolerante(it), ...
            nPasi, norm(zTest-zExact,2), normaFinala);
    end
end

%% Functie locala: metoda gradientului conjugat
function [z, nPasi, normaFinala] = ...
    rezolvaCG(H,b,z0,tol,maxIter)

    z = z0;
    g = H*z-b;
    d = -g;
    nPasi = 0;

    while norm(g,2) >= tol && nPasi < maxIter

        alpha = -(g'*d)/(d'*H*d);
        zNou = z + alpha*d;
        gNou = H*zNou-b;
        nPasi = nPasi + 1;

        if norm(gNou,2) < tol
            z = zNou;
            g = gNou;
            break;
        end

        beta = (gNou'*gNou)/(g'*g);
        d = -gNou + beta*d;

        z = zNou;
        g = gNou;
    end

    normaFinala = norm(g,2);
end
